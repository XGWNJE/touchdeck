<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- 仅合并到 Debug APK；用于真实 DataChannel 的重复 requestId 验收。 -->
        <receiver
            android:name=".DebugActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="cn.touchdeck.app.DEBUG_ACTION" />
            </intent-filter>
        </receiver>
        <!-- 仅合并到 Debug APK；绕过设备输入法差异，驱动真实信令与 DataChannel 配对验收。 -->
        <receiver
            android:name=".DebugPairReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="cn.touchdeck.app.DEBUG_PAIR" />
            </intent-filter>
        </receiver>
        <!-- 仅合并到 Debug APK；不发送按键，只用于真机比较动作结果触感。 -->
        <receiver
            android:name=".DebugFeedbackReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="cn.touchdeck.app.DEBUG_FEEDBACK" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
