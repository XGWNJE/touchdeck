{
  "behavior": {
    "confirmSeconds": 2.5
  },
  "layout": {
    "columns": 2,
    "gap": 6,
    "padding": 7,
    "buttonSize": 60,
    "showLabel": false,
    "showSub": false
  },
  "theme": {
    "name": "单色描边（AI 生成图标）",
    "description": "默认深色皮肤 + Grsai 生成的统一描边图标集（themes/mono/icons/*.png）",
    "bar": {
      "backgroundRgb": "24, 24, 28",
      "opacity": 0.92,
      "idleDimOpacity": 0.6,
      "borderRadius": 10,
      "borderColor": "rgba(255,255,255,0.08)"
    },
    "button": {
      "background": "#2e2e36",
      "color": "#eeeeee",
      "subColor": "#999999",
      "borderRadius": 8,
      "borderColor": "rgba(255,255,255,0.10)",
      "iconSize": 16,
      "labelSize": 10,
      "subSize": 6
    },
    "groups": {
      "voice": {
        "background": "#14532d",
        "borderColor": "rgba(34,197,94,0.33)"
      },
      "agent": {
        "background": "#1e3a5f",
        "borderColor": "rgba(59,130,246,0.33)"
      },
      "danger": {
        "background": "#5f1e1e",
        "borderColor": "rgba(239,68,68,0.33)"
      },
      "cmd": {
        "background": "#4a3a1e",
        "borderColor": "rgba(245,158,11,0.33)"
      },
      "edit": {
        "background": "#2e2e36",
        "borderColor": "rgba(255,255,255,0.10)"
      }
    },
    "pressed": {
      "background": "#f8fafc",
      "color": "#111111",
      "subColor": "#555555"
    },
    "armed": {
      "background": "#713f12",
      "color": "#fde047",
      "subColor": "#fde047",
      "borderColor": "#facc15",
      "glowColor": "rgba(250,204,21,0.67)"
    }
  },
  "buttons": [
    {
      "id": "voice",
      "icon": "mic",
      "label": "语音",
      "sub": "启动语音",
      "group": "voice",
      "confirm": false
    },
    {
      "id": "steer",
      "icon": "zap",
      "label": "Steer",
      "sub": "插队提示词",
      "group": "agent",
      "confirm": false
    },
    {
      "id": "esc",
      "icon": "hand",
      "label": "中断",
      "sub": "Esc",
      "group": "danger",
      "confirm": true
    },
    {
      "id": "enter",
      "icon": "send",
      "label": "发送",
      "sub": "Enter",
      "group": "agent",
      "confirm": false
    },
    {
      "id": "backspace",
      "icon": "delete",
      "label": "退格",
      "sub": "Backspace",
      "group": "edit",
      "confirm": false
    },
    {
      "id": "slash",
      "icon": "slash",
      "label": "命令",
      "sub": "斜杠",
      "group": "cmd",
      "confirm": false
    },
    {
      "id": "plan",
      "icon": "clipboard-list",
      "label": "Plan",
      "sub": "Shift+Tab",
      "group": "agent",
      "confirm": false
    },
    {
      "id": "selectall",
      "icon": "square-dashed",
      "label": "全选",
      "sub": "Ctrl+A",
      "group": "agent",
      "confirm": false
    },
    {
      "id": "newline",
      "icon": "corner-down-left",
      "label": "换行",
      "sub": "Shift+Enter",
      "group": "edit",
      "confirm": false
    },
    {
      "id": "at",
      "icon": "at-sign",
      "label": "文件",
      "sub": "引用",
      "group": "cmd",
      "confirm": false
    },
    {
      "id": "copy",
      "icon": "copy",
      "label": "复制",
      "sub": "Ctrl+C",
      "group": "edit",
      "confirm": false
    },
    {
      "id": "paste",
      "icon": "clipboard-paste",
      "label": "粘贴",
      "sub": "Ctrl+V",
      "group": "edit",
      "confirm": false
    }
  ]
}