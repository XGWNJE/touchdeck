{
  "name": "右缘块状面板",
  "description": "4×3 块状，停靠屏幕右边缘居中",
  "buttonSize": 120,
  "gap": 12,
  "padding": 14,
  "columns": 4,
  "position": "right",
  "scale": 1,
  "buttons": [
    {
      "id": "voice",
      "icon": "mic",
      "label": "语音",
      "sub": "启动语音",
      "group": "voice",
      "keys": {
        "ctrl": true,
        "win": true,
        "shift": true
      }
    },
    {
      "id": "esc",
      "icon": "hand",
      "label": "中断",
      "sub": "Esc",
      "group": "danger",
      "confirm": true,
      "keys": {
        "key": "escape"
      }
    },
    {
      "id": "command-menu",
      "icon": "slash",
      "label": "菜单",
      "sub": "Ctrl+K",
      "group": "agent",
      "keys": {
        "ctrl": true,
        "key": "k"
      }
    },
    {
      "id": "enter",
      "icon": "send",
      "label": "发送",
      "sub": "Enter",
      "group": "agent",
      "keys": {
        "key": "enter"
      }
    },
    {
      "id": "newline",
      "icon": "corner-down-left",
      "label": "换行",
      "sub": "Shift+Enter",
      "group": "edit",
      "keys": {
        "shift": true,
        "key": "enter"
      }
    },
    {
      "id": "clear-input",
      "icon": "eraser",
      "label": "清空",
      "sub": "清空输入框",
      "group": "edit",
      "macro": [
        { "keys": { "ctrl": true, "key": "a" } },
        { "keys": { "key": "backspace" } }
      ]
    },
    {
      "id": "slash",
      "icon": "slash",
      "label": "命令",
      "sub": "斜杠",
      "group": "cmd",
      "keys": {
        "text": "/"
      }
    },
    {
      "id": "paste",
      "icon": "clipboard-paste",
      "label": "粘贴",
      "sub": "Ctrl+V",
      "group": "edit",
      "keys": {
        "ctrl": true,
        "key": "v"
      }
    },
    {
      "id": "delete-word",
      "icon": "delete",
      "label": "删词",
      "sub": "Ctrl+Backspace",
      "group": "edit",
      "keys": {
        "ctrl": true,
        "key": "backspace"
      }
    }
  ],
  "showLabel": false,
  "showSub": false
}
